FAL_KEY=
AGNES_API_KEY=
# Server-side fallback. The Admin runtime switch overrides this value.
DREAMFACE_IO_ENABLED=true
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Maximum time allowed for Supabase task-history reads and provider status sync.
TASK_HISTORY_TIMEOUT_MS=12000
TASK_SYNC_TIMEOUT_MS=3500

# Set this to the deployed commit hash before `next build` in production.
NEXT_DEPLOYMENT_ID=

# Historical Stripe compatibility only. Keep these while legacy Stripe
# subscriptions still need webhook updates or Billing Portal access.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000
ADMIN_EMAILS=

# Protects scheduled task sync and PayPal reconciliation cron routes.
# Set the same value in Vercel environment variables for production.
CRON_SECRET=
AUTH_RATE_LIMIT_SECRET=
ANALYTICS_IP_SECRET=

# MySQL. When the app and database run on the same BT server, keep host local
# and do not expose port 3306 publicly.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_CONNECTION_LIMIT=10
MYSQL_SSL=false
MYSQL_SSL_REJECT_UNAUTHORIZED=true
# MYSQL_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# Fallback models per mode
FAL_MODEL_IMAGE_DEFAULT=fal-ai/flux/schnell
FAL_MODEL_VIDEO_DEFAULT=

# Optional provider-specific overrides
FAL_MODEL_IMAGE_CHATGPT=
FAL_MODEL_IMAGE_CHATGPT_EDIT=
FAL_MODEL_IMAGE_NANO_BANANA=
FAL_MODEL_IMAGE_NANO_BANANA_EDIT=
FAL_MODEL_IMAGE_FLUX=
FAL_MODEL_IMAGE_FLUX_DEV=
FAL_MODEL_IMAGE_RECRAFT=
FAL_MODEL_VIDEO_SEEDANCE=
FAL_MODEL_VIDEO_SEEDANCE_I2V=
FAL_MODEL_VIDEO_MINIMAX_H3_MAX=
FAL_MODEL_VIDEO_MINIMAX_H3_MAX_I2V=
FAL_MODEL_VIDEO_MINIMAX_H3_MAX_TURBO=
FAL_MODEL_VIDEO_MINIMAX_H3_MAX_TURBO_I2V=
FAL_MODEL_VIDEO_HAPPY_HORSE=
FAL_MODEL_VIDEO_HAPPY_HORSE_I2V=
FAL_MODEL_VIDEO_KLING=
FAL_MODEL_VIDEO_KLING_I2V=
FAL_MODEL_VIDEO_VEO=

# PayPal is the only provider for new checkouts. Stripe variables remain above only
# for historical Stripe subscription webhooks and customer portal access.
# Use sandbox until checkout, webhook, cancellation, renewal, and reconciliation tests pass.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# PayPal recurring Plan IDs matching the six DreamFace subscription prices.
PAYPAL_PLAN_PREMIUM_LITE_WEEKLY=
PAYPAL_PLAN_PREMIUM_LITE_MONTHLY=
PAYPAL_PLAN_PREMIUM_LITE_YEARLY=
PAYPAL_PLAN_PREMIUM_WEEKLY=
PAYPAL_PLAN_PREMIUM_MONTHLY=
PAYPAL_PLAN_PREMIUM_YEARLY=
