FAL_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Set this to the deployed commit hash before `next build` in production.
NEXT_DEPLOYMENT_ID=

# Stripe Checkout
# Production:
#   STRIPE_SECRET_KEY=sk_live_...
#   STRIPE_WEBHOOK_SECRET=whsec_... from the live webhook endpoint
#   NEXT_PUBLIC_APP_URL=https://dreamface.io
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional. Enable only after Stripe Tax is configured in the Stripe dashboard.
STRIPE_AUTOMATIC_TAX=false

# Stripe recurring Price IDs for Premium subscriptions.
# Create these as recurring prices in Stripe before enabling subscription checkout.
# Also enable Stripe Billing Portal in the Stripe dashboard before using Manage billing.
STRIPE_PRICE_PREMIUM_LITE_WEEKLY=
STRIPE_PRICE_PREMIUM_LITE_MONTHLY=
STRIPE_PRICE_PREMIUM_LITE_YEARLY=
STRIPE_PRICE_PREMIUM_WEEKLY=
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_YEARLY=
ADMIN_EMAILS=

# Fallback models per mode
FAL_MODEL_IMAGE_DEFAULT=fal-ai/flux/schnell
FAL_MODEL_VIDEO_DEFAULT=

# Optional provider-specific overrides
FAL_MODEL_IMAGE_CHATGPT=
FAL_MODEL_IMAGE_CHATGPT_EDIT=
FAL_MODEL_IMAGE_NANO_BANANA=
FAL_MODEL_IMAGE_NANO_BANANA_EDIT=
FAL_MODEL_IMAGE_FLUX=
FAL_MODEL_IMAGE_FLUX_DEV=
FAL_MODEL_IMAGE_RECRAFT=
FAL_MODEL_VIDEO_SEEDANCE=
FAL_MODEL_VIDEO_SEEDANCE_I2V=
FAL_MODEL_VIDEO_KLING=
FAL_MODEL_VIDEO_KLING_I2V=
FAL_MODEL_VIDEO_VEO=
