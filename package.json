{
  "name": "nova-ai-studio",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit --pretty false",
    "verify:locales": "node scripts/verify-all-locales.mjs",
    "verify:security": "node scripts/verify-security-invariants.mjs",
    "verify:referrals": "node scripts/verify-referrals.mjs",
    "verify:gpt-image": "node scripts/verify-gpt-image.mjs && node scripts/verify-gpt-image-pricing.mjs",
    "verify:payments": "node scripts/verify-paypal-checkout.mjs",
    "verify:wallets": "node scripts/verify-paypal-wallets.mjs && node scripts/verify-wallet-loading.mjs",
    "verify:analytics": "node scripts/verify-analytics-value.mjs && node scripts/verify-login-success.mjs && node scripts/verify-growth.mjs",
    "verify:dodo": "node scripts/verify-dodo-payments.mjs",
    "verify:video-prompt-ai": "node scripts/verify-video-prompt-ai.mjs",
    "verify:task-history": "node scripts/verify-task-history.mjs",
    "verify:studio-performance": "node scripts/verify-studio-performance.mjs",
    "verify:studio-inputs": "node scripts/verify-studio-inputs.mjs",
    "verify:video-keyframes": "node scripts/verify-video-keyframes.mjs && node scripts/verify-gemini-omni.mjs",
    "verify:model-upgrades": "node scripts/verify-model-upgrades.mjs",
    "verify:heygen-video": "node scripts/verify-heygen-video.mjs",
    "verify:pricing": "node scripts/verify-cost-tier-pricing.mjs",
    "verify:gallery": "node scripts/verify-gallery-pagination.mjs",
    "verify:avatars": "node scripts/verify-avatar-library.mjs && node scripts/verify-avatar-previews.mjs",
    "verify:model-suspension": "node scripts/verify-model-suspension.mjs",
    "verify:h3-daily-free": "node scripts/verify-h3-daily-free.mjs",
    "check": "npm run typecheck && npm run verify:locales && npm run verify:security && npm run verify:referrals && npm run verify:gpt-image && npm run verify:payments && npm run verify:wallets && npm run verify:analytics && npm run verify:dodo && npm run verify:video-keyframes && npm run verify:model-upgrades && npm run verify:heygen-video && npm run verify:flux3 && npm run verify:model-suspension && npm run verify:h3-daily-free && npm run verify:video-prompt-ai && npm run verify:avatars && npm run verify:gallery && npm run verify:task-history && npm run verify:studio-performance && npm run verify:studio-inputs && npm run verify:auth && npm run verify:studio-billing && npm run verify:studio-templates && npm run verify:studio-virtual-gallery && npm run build",
    "verify:flux3": "node scripts/verify-flux3-max.mjs",
    "verify:studio-billing": "node scripts/verify-studio-billing.mjs",
    "verify:studio-templates": "node scripts/verify-studio-templates.mjs",
    "verify:studio-virtual-gallery": "node scripts/verify-studio-virtual-gallery.mjs",
    "verify:auth": "node scripts/verify-auth-dialog.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.4",
    "@swc/helpers": "0.5.23",
    "disposable-email-domains": "1.0.62",
    "dodopayments": "^2.54.2",
    "mysql2": "^3.22.5",
    "next": "^15.5.15",
    "next-intl": "^4.13.0",
    "react": "^19.1.2",
    "react-dom": "^19.1.2",
    "stripe": "^22.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3"
  }
}
